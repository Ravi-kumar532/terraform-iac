# Copy to dev.tfvars (gitignored). Configure IAM OIDC and remote-state bootstrap separately.
environment = "dev"
region = "REPLACE_WITH_AWS_REGION"
common_tags = { ManagedBy = "Terraform", Environment = "dev" }
aws_app_runner = []
aws_appconfig = []
aws_ecr = []
aws_eks = []
aws_elastic_beanstalk = []
aws_eventbridge = []
aws_lambda = []
aws_monitoring = []
aws_rds_mysql = []
aws_rds_sql_server = []
aws_resource_groups = []
aws_s3_bucket = []
aws_sqs_sns = []
aws_step_functions = []
aws_subnet = []
aws_vpc = []
